{
  "name": "lockwood-it-solutions",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-static-config.mjs",
    "typecheck": "tsc --noEmit",
    "check:output": "node scripts/check-output.mjs",
    "test:api": "npm --prefix api test",
    "validate": "npm run typecheck && npm run build && npm run check:output && npm run test:api"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.19",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  }
}
